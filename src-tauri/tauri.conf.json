{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Form Editor",
  "mainBinaryName": "pdf-form-editor",
  "version": "0.1.3",
  "identifier": "com.kushgene.pdf-form-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Editor",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "msi"
    ],
    "publisher": "KushGene",
    "shortDescription": "Desktop editor for PDF form fields",
    "longDescription": "PDF Form Editor lets you open PDF files, fill in and edit AcroForm fields, add signatures, and export the result — all in a lightweight desktop app.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 KushGene",
    "homepage": "https://github.com/KushGene/pdf-editor",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/desktop-template.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/desktop-template.desktop"
      }
    }
  }
}
